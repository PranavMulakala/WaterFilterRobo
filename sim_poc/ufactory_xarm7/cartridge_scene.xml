<mujoco model="cartridge insertion cell">
  <include file="xarm7.xml"/>

  <statistic center="0.4 0 0.3" extent="1.1"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.2 0.2 0.2"/>
    <global azimuth="150" elevation="-25" offheight="720" offwidth="1280"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.85 0.9 0.95" rgb2="0.55 0.65 0.75" width="256" height="256"/>
    <texture name="floortex" type="2d" builtin="checker" rgb1="0.32 0.34 0.38" rgb2="0.38 0.40 0.44" width="256" height="256"/>
    <material name="floormat" texture="floortex" texrepeat="6 6" reflectance="0.05"/>
    <material name="benchmat" rgba="0.72 0.74 0.78 1" reflectance="0.1"/>
    <material name="cartmat" rgba="0.22 0.55 0.85 1" reflectance="0.3"/>
    <material name="capmat" rgba="0.95 0.95 0.97 1"/>
    <material name="socketmat" rgba="0.9 0.9 0.92 1"/>
    <material name="socketbase" rgba="0.25 0.27 0.3 1"/>
  </asset>

  <worldbody>
    <light pos="0.5 -0.5 1.6" dir="-0.3 0.3 -1" diffuse="0.75 0.75 0.75"/>
    <light pos="0.3 0.6 1.4" dir="0 -0.4 -1" diffuse="0.45 0.45 0.45"/>

    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.7" material="floormat"/>
    <geom name="bench" type="box" size="0.55 0.6 0.35" pos="0.35 0 -0.35" material="benchmat"/>

    <!-- fixed cameras for the video -->
    <camera name="main" pos="1.35 -0.9 0.75" xyaxes="0.6 0.8 0 -0.28 0.21 0.93"/>
    <camera name="side" pos="0.45 -1.3 0.45" xyaxes="1 0 0 0 0.32 0.95"/>
    <camera name="top" pos="0.45 0 1.4" xyaxes="0 -1 0 1 0 0"/>

    <!-- the filter cartridge: free-floating cylinder the robot must grasp -->
    <body name="cartridge" pos="0.46 -0.26 0.062">
      <freejoint name="cartridge_free"/>
      <geom name="cart_body" type="cylinder" size="0.021 0.055" material="cartmat" mass="0.15"
            friction="1.2 0.02 0.0002" condim="4"/>
      <geom name="cart_cap" type="cylinder" size="0.0215 0.006" pos="0 0 0.058" material="capmat" mass="0.01"/>
      <site name="cart_top" pos="0 0 0.06" size="0.005"/>
    </body>

    <!-- the socket: hollow receptacle built from a ring of 10 wall segments -->
    <body name="socket" pos="0.46 0.26 0">
      <geom name="socket_base" type="cylinder" size="0.055 0.008" pos="0 0 0.008" material="socketbase"/>
      <geom type="box" size="0.006 0.016 0.045" pos="0.0345 0.0 0.061"  euler="0 0 0"    material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="0.0279 0.0203 0.061" euler="0 0 0.628" material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="0.0107 0.0328 0.061" euler="0 0 1.257" material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="-0.0107 0.0328 0.061" euler="0 0 1.885" material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="-0.0279 0.0203 0.061" euler="0 0 2.513" material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="-0.0345 0.0 0.061"  euler="0 0 3.142" material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="-0.0279 -0.0203 0.061" euler="0 0 3.770" material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="-0.0107 -0.0328 0.061" euler="0 0 4.398" material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="0.0107 -0.0328 0.061" euler="0 0 5.027" material="socketmat"/>
      <geom type="box" size="0.006 0.016 0.045" pos="0.0279 -0.0203 0.061" euler="0 0 5.655" material="socketmat"/>
      <site name="socket_center" pos="0 0 0.016" size="0.005"/>
    </body>
  </worldbody>
</mujoco>
